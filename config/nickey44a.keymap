/* DYA Studio / ZMK Studio で Mod-Tap・Layer-Tap など全ビヘイビアを使えるようにする */
#ifndef ZMK_BEHAVIORS_KEEP_ALL
#define ZMK_BEHAVIORS_KEEP_ALL
#endif

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* 俺風キーマップ（ZaruBall / cocot36 流儀） */
#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    /* コンボ（DYA Studio の「コンボ」タブから編集・追加できます） */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        combo_lbkt {
            key-positions = <32 33>;
            bindings = <&kp LBKT>;
            layers = <BASE>;
            display-name = "N+M [";
            timeout-ms = <50>;
        };

        combo_rbkt {
            key-positions = <34 35>;
            bindings = <&kp RBKT>;
            layers = <BASE>;
            display-name = ",+. ]";
            timeout-ms = <50>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* 0: ベース
           左親指 = Alt / Cmd / Space(長押しRAISE)
           右親指 = Enter(長押しLOWER) / Backspace / Space(長押しADJUST) */
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB          &kp Q  &kp W  &kp E  &kp R  &kp T                              &kp Y  &kp U  &kp I      &kp O    &kp P         &kp MINUS
&mt LCTRL CAPS   &kp A  &kp S  &kp D  &kp F  &kp G                              &kp H  &kp J  &kp K      &kp L    &kp SEMI      &kp SQT
&kp LSHFT        &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LBKT          &kp RBKT  &kp N  &kp M  &kp COMMA  &kp DOT  &kp RS(FSLH)  &mt RSHFT FSLH
                         &kp LALT  &kp LGUI  &lt RAISE SPACE          &lt LOWER RET  &kp BSPC  &lt ADJUST SPACE
            >;
        };

        /* 1: LOWER（Enter長押し）= シフト数字＋矢印＋かな/英数 */
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                      &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)  &kp EQUAL
&trans   &kp LEFT    &kp UP      &kp RIGHT   &kp LSHFT   &kp LANG1                       &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH    &kp GRAVE
&trans   &kp LEFT    &kp DOWN    &kp RIGHT   &kp LCTRL   &kp LANG2   &trans      &trans  &trans      &trans      &trans      &trans      &trans      &trans
                                             &trans      &trans      &trans      &trans  &trans      &kp DEL
            >;
        };

        /* 2: RAISE（Space長押し）= 数字＋矢印＋かな/英数＋F/ナビ */
        raise_layer {
            display-name = "Raise";
            bindings = <
&kp ESC  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5                      &kp N6    &kp N7     &kp N8     &kp N9     &kp N0      &kp EQUAL
&trans   &kp LEFT  &kp UP    &kp RIGHT  &kp LSHFT  &kp LANG1                   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans      &trans
&trans   &kp LEFT  &kp DOWN  &kp RIGHT  &kp LCTRL  &kp LANG2  &trans   &trans  &kp F1    &kp F2     &kp F3     &kp F4     &kp F5      &kp F6
                                        &trans     &trans     &trans   &trans  &trans    &kp DEL
            >;
        };

        /* 3: ADJUST（右親指Space長押し）= Bluetooth・音量 */
        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &none  &none  &bootloader
&bt BT_CLR_ALL  &none         &none         &none         &none         &none                              &none         &none         &none       &none  &none  &none
&trans          &none         &none         &none         &none         &none         &none       &none    &none         &none         &none       &none  &none  &studio_unlock
                                                          &trans        &trans        &trans      &trans   &trans        &trans
            >;
        };

        /* DYA Studioでレイヤーを追加するための予備 */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
